# Postgres (required for /api/health and the local signaling fallback)
# Prefer a pooled URL in production (Supabase transaction pooler on :6543).
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db
POSTGRES_URL=
POSTGRES_URL_NON_POOLING=

# Optional: used if the URLs above are unset
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=
# POSTGRES_HOST=db.<project>.supabase.co
# POSTGRES_DATABASE=postgres

# Supabase Realtime (optional — when both are set, WebRTC signaling uses
# Realtime broadcast instead of the Postgres signal_events table)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
